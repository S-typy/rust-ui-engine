<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свойства объектов" Width="700" Height="760" Padding="12">
  <Grid Spacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Свойства документов" Grid.Row="0" FontSize="21" FontWeight="SemiBold"/>
    <PropertyGrid Grid.Row="1" Scrollable="True" x:Name="DocumentProperties" AutomationName="Инспектор двух документов"
                  DataSource="InspectionObjects" ObjectKeys="1,2" LabelWidth="44%">
      <PropertyGrid.Properties>
        <Property FieldName="name" Label="Название" Category="Документ" DefaultValue="Без названия"/>
        <Property FieldName="author" Label="Автор" Category="Документ"/>
        <Property FieldName="department" Label="Подразделение" Category="Документ"/>
        <Property FieldName="enabled" Label="Включён" Category="Документ" DefaultIsNull="True"/>
        <Property FieldName="accent" Label="Цвет метки" Preview="Color" Category="Документ"/>
        <Property FieldName="progress" Label="Готовность" Preview="Progress" IsReadOnly="True" Category="Документ"/>
        <Property FieldName="identifier" Label="Идентификатор" Category="Документ" IsReadOnly="True"/>
        <Property FieldName="count" Label="Количество" Category="Параметры" Group="Размеры" DefaultValue="10"/>
        <Property FieldName="price" Label="Стоимость" Category="Параметры" Group="Финансы" DefaultValue="0"/>
        <Property FieldName="created" Label="Дата создания" Category="Параметры" DefaultValue="2026-01-01"/>
        <Property FieldName="time" Label="Время изменения" Category="Публикация"/>
        <Property FieldName="edition" Label="Версия" Category="Публикация"/>
        <Property FieldName="status" Choices="Черновик|На согласовании|Утверждён" Label="Статус" Category="Публикация">
          <Property.DisplayTemplate>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Icon Symbol="Edit" Width="14" Height="14" VerticalAlignment="Center"/>
              <TextBlock x:Name="PART_Value" VerticalAlignment="Center"/>
            </StackPanel>
          </Property.DisplayTemplate>
        </Property>
        <Property FieldName="cover" Label="Обложка" Category="Карточка документа" FullWidth="True" IsReadOnly="True">
          <Property.DisplayTemplate>
            <Image Source="Landscape" Width="224" Height="112" HorizontalAlignment="Center" Stretch="Uniform" AutomationName="Обложка документов"/>
          </Property.DisplayTemplate>
        </Property>
        <Property FieldName="notes" Label="Примечание" Category="Карточка документа" FullWidth="True" IsReadOnly="True">
          <Property.DisplayTemplate>
            <TextBlock x:Name="PART_Value" Margin="8,4,8,4" TextWrapping="Wrap"/>
          </Property.DisplayTemplate>
        </Property>
      </PropertyGrid.Properties>
    </PropertyGrid>
    <Expander x:Name="PropertyOperations" Grid.Row="2" Header="Операции с документами" IsExpanded="False">
      <StackPanel Spacing="4">
        <WrapPanel Spacing="4">
          <Button x:Name="PropertyResetCount" Content="Сбросить количество" Command="PropertyDemoReset"/>
          <Button x:Name="PropertyReject" Content="Проверить отказ записи" Command="PropertyDemoReject"/>
          <Button x:Name="PropertyExternal" Content="Изменить источник" Command="PropertyDemoExternal"/>
          <Button x:Name="PropertyRefresh" Content="Обновить" Command="PropertyDemoRefresh"/>
          <Button x:Name="PropertyCancel" Content="Отменить имя" Command="PropertyDemoCancel"/>
        </WrapPanel>
        <TextBlock x:Name="PropertyAccepted" Text="" TextWrapping="Wrap"/>
        <TextBlock x:Name="PropertyActivity" Text="" TextWrapping="Wrap" TextTone="Secondary"/>
      </StackPanel>
    </Expander>
  </Grid>
</Window>
