<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Документы · Rust UI" Width="1200" Height="800" Padding="0" Theme="Light">
  <StackPanel Spacing="8">
    <Ribbon SelectedTab="Documents">
      <RibbonTab Id="Documents" Header="Документы" KeyTip="D">
        <RibbonGroup Id="Views" Header="Представление">
          <Button KeyTip="A" Command="DocTabbed" Icon="Copy"/>
          <Button KeyTip="B" Command="DocMdi" Icon="Copy"/>
          <Button KeyTip="C" Command="DocWindowed" Icon="FolderOpen"/>
          <Button KeyTip="D" Command="DocCascade" Size="Small"/>
          <Button KeyTip="E" Command="DocTile" Size="Small"/>
        </RibbonGroup>
        <RibbonGroup Id="Lifecycle" Header="Сохранение и закрытие">
          <Button KeyTip="F" Command="DocSave" Icon="Save"/>
          <Button KeyTip="G" Command="DocClose" Icon="Close" Size="Small"/>
          <Button KeyTip="H" Command="DocCloseGroup" Size="Small"/>
          <Button KeyTip="I" Command="DocCloseAll" Size="Small"/>
          <Button KeyTip="J" Command="DocOpenAll" Icon="FolderOpen"/>
          <Button KeyTip="K" Command="DocFailSave" Size="Small"/>
        </RibbonGroup>
        <RibbonGroup Id="Appearance" Header="Оформление">
          <Button KeyTip="L" Command="Light" Icon="Sun" Size="Small"/>
          <Button KeyTip="M" Command="Dark" Icon="Moon" Size="Small"/>
        </RibbonGroup>
      </RibbonTab>
    </Ribbon>
    <DockWorkspace>
      <DockGroup SelectedPane="Plan">
        <DockPane Id="Plan" Header="План проекта" MinWidth="280" MinHeight="180">
          <StackPanel Padding="20" Spacing="12">
            <TextBlock Text="План проекта" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Измените текст и переключите вид: редактор остаётся тем же." TextWrapping="Wrap"/>
            <TextBox x:Name="PlanText" Text="Подготовить рабочую область" CommitOnLostFocus="False"/>
            <TextBlock Text="Закрытие группы сначала согласует каждый изменённый документ." TextWrapping="Wrap" TextTone="Secondary"/>
          </StackPanel>
        </DockPane>
        <DockPane Id="Notes" Header="Заметки" MinWidth="260" MinHeight="160">
          <StackPanel Padding="20" Spacing="12">
            <TextBlock Text="Заметки" FontSize="22" FontWeight="SemiBold"/>
            <TextBox x:Name="NotesText" Text="Идеи для следующего выпуска" CommitOnLostFocus="False"/>
            <TextBlock Text="Отмена закрытия оставляет весь набор открытым." TextWrapping="Wrap" TextTone="Secondary"/>
          </StackPanel>
        </DockPane>
        <DockPane Id="Draft" Header="Черновик" MinWidth="240" MinHeight="140">
          <StackPanel Padding="20" Spacing="12">
            <TextBlock Text="Черновик" FontSize="22" FontWeight="SemiBold"/>
            <TextBox x:Name="DraftText" Text="Незавершённый документ" CommitOnLostFocus="False"/>
            <TextBlock Text="Сохранение примера использует память приложения. Запись файлов выполняет приложение." TextWrapping="Wrap" TextTone="Secondary"/>
          </StackPanel>
        </DockPane>
      </DockGroup>
    </DockWorkspace>
  </StackPanel>
</Window>
