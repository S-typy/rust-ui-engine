<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Штрихкоды" Width="1000" Height="800">
  <StackPanel Padding="24" Spacing="8">
    <TextBlock Text="Штрихкоды · векторное представление" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Код и контрольная цифра проверяются до изменения изображения. Белые поля входят в геометрию."/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="BarcodeChange" Content="Другое значение" Command="BarcodeChange"/>
      <Button x:Name="BarcodeReject" Content="Неверная цифра" Command="BarcodeReject"/>
      <Button x:Name="BarcodeRestore" Content="Восстановить" Command="BarcodeRestore"/>
    </StackPanel>
    <TextBlock Text="EAN-13 · контрольная цифра рассчитана"/>
    <Barcode x:Name="BarcodeEan13" Value="400638133393" ModuleSize="3" BarHeight="72" HorizontalAlignment="Left"/>
    <TextBlock Text="EAN-8 · полное значение проверено"/>
    <Barcode x:Name="BarcodeEan8" Symbology="Ean8" Value="96385074" ModuleSize="3" BarHeight="56" HorizontalAlignment="Left"/>
    <TextBlock Text="Code 128 B · печатный ASCII"/>
    <Barcode x:Name="BarcodeAscii" Symbology="Code128B" Value="Rust UI 2026" ModuleSize="2" BarHeight="64" HorizontalAlignment="Left"/>
    <TextBlock Text="При нехватке места обрезанный код не выводится:"/>
    <Barcode x:Name="BarcodeClipped" Value="400638133393" Width="120" Height="48"/>
    <TextBlock Text="SVG и печатная геометрия используют те же полосы. Размер модуля в печати округляется до целого числа точек." TextWrapping="Wrap"/>
    <TextBlock x:Name="BarcodeStatus" Text="Готово"/>
  </StackPanel>
</Window>
