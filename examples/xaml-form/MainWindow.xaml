<Window xmlns="urn:rust-ui-engine:ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ · Rust UI" Width="1040" Height="720"
        Padding="12" Theme="Light">
    <StackPanel x:Name="Shell" Spacing="20">
        <Ribbon x:Name="MainRibbon" SelectedTab="Home" AutomationName="Лента команд">
            <Ribbon.QuickAccessToolbar>
                <Button Command="Confirm" />
                <Button Command="Pin" />
                <Button Command="Clear" />
            </Ribbon.QuickAccessToolbar>
            <RibbonTab Id="Home" Header="Главная" KeyTip="H">
                <RibbonGroup Id="Document" Header="Документ" CollapsePriority="1">
                    <SplitButton Command="Confirm" KeyTip="S" Icon="Check"
                                 ToolTip="Подтвердить значение или выбрать другое действие">
                        <MenuItem Command="Confirm" />
                        <MenuItem Command="Clear" />
                        <MenuSeparator />
                        <MenuItem Header="Оформление">
                            <MenuItem Command="Light" />
                            <MenuItem Command="Dark" />
                        </MenuItem>
                    </SplitButton>
                    <Button Command="Clear" KeyTip="N" Icon="Eraser" ToolTip="Очистить текст" />
                </RibbonGroup>
                <RibbonGroup Id="Editing" Header="Редактирование" CollapsePriority="2">
                    <ToggleButton Command="Pin" Size="Small" KeyTip="P" Icon="Pin"
                                  ToolTip="Закрепить документ" />
                    <Button Command="Confirm" Size="Small" KeyTip="E" />
                    <Button Command="Disabled" Size="Small" KeyTip="D" Icon="Lock" />
                </RibbonGroup>
                <RibbonGroup Id="Actions" Header="Действия" CollapsePriority="3">
                    <DropDownButton Command="Actions" KeyTip="A" Icon="FolderOpen"
                                    ToolTip="Открыть меню действий">
                        <MenuItem Command="Confirm" />
                        <MenuItem Header="Документ">
                            <MenuItem Command="Pin" />
                            <MenuItem Command="Clear" />
                            <MenuSeparator />
                            <MenuItem Command="Disabled" />
                        </MenuItem>
                    </DropDownButton>
                </RibbonGroup>
            </RibbonTab>
            <RibbonTab Id="View" Header="Вид" KeyTip="V">
                <RibbonGroup Id="Appearance" Header="Оформление" CollapsePriority="1">
                    <Button Command="Light" KeyTip="L" Icon="Sun" />
                    <Button Command="Dark" KeyTip="D" Icon="Moon" />
                </RibbonGroup>
                <RibbonGroup Id="ViewOptions" Header="Документ" CollapsePriority="2">
                    <ToggleButton Command="Pin" Size="Small" KeyTip="P" />
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
        <StackPanel x:Name="Form" Surface="Card" Spacing="12" Padding="20" Margin="4,0,4,0">
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Документ без имени" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Содержимое и параметры документа" FontSize="13" TextTone="Secondary" />
            </StackPanel>
            <TextBlock Text="Текст сообщения" FontSize="13" FontWeight="SemiBold" />
            <TextBox x:Name="Message" Height="36" FontSize="14" Padding="12,5"
                     CornerRadius="4" BorderThickness="1" MaxLength="64"
                     IsRequired="True" CommitOnLostFocus="True"
                     ValidationMessage="Введите текст перед подтверждением."
                     AutomationName="Текст" PlaceholderText="Введите текст…" />
            <CheckBox x:Name="Option" Content="Только чтение" />
            <StackPanel Orientation="Horizontal" Spacing="8" Height="36" Margin="0,4,0,4">
                <Button x:Name="Confirm" Content="Подтвердить" Command="Confirm" Icon="Check" Width="152" />
                <ToggleButton x:Name="Pin" Content="Закрепить" Command="Pin" Icon="Pin" Width="128" />
            </StackPanel>
            <Separator />
            <TextBlock x:Name="Help" FontSize="12" TextTone="Secondary"
                       Text="Alt или F10 — команды ленты · Enter — подтвердить · Escape — отменить" />
            <TextBlock x:Name="Status" FontSize="13" TextTone="Secondary" Text="Изменений нет." />
        </StackPanel>
    </StackPanel>
</Window>
