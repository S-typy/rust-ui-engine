<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки документа" Width="560" Height="320" Padding="24">
  <Grid Spacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Название документа" FontSize="22" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Spacing="10">
      <TextBox x:Name="DialogEditor" Text="Новый документ" IsRequired="True" MaxLength="80" AutomationName="Название документа"/>
      <TextBlock Text="Enter — принять · Escape — отменить" TextTone="Secondary"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="AcceptDialog" Content="Принять" Command="DialogAccept" Width="130"/>
      <Button x:Name="CancelDialog" Content="Отмена" Command="DialogCancel" Width="130"/>
    </StackPanel>
  </Grid>
</Window>
