<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панели и элементы формы · Rust UI" Width="1200" Height="840" Padding="24">
  <Grid Spacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock FontSize="26" TextWrapping="NoWrap">
        <Run Text="Рабочая форма " FontWeight="SemiBold"/><Run Text="· панели и управление" Foreground="#667788"/>
      </TextBlock>
      <TextBlock x:Name="BatchGreeting" Text="Размеры панелей, выбор значений и всплывающее содержимое сохраняют состояние формы." TextTone="Secondary"/>
      <TextBlock x:Name="BatchCultureDetails" Text="Формат чисел и дат" TextTone="Secondary" FontSize="12"/>
    </StackPanel>
    <MenuBar x:Name="MainMenu" Grid.Row="1">
      <DropDownButton x:Name="DocumentMenu" Content="Документ">
        <MenuItem Header="Подтвердить" Command="Confirm"/><MenuItem Header="Очистить" Command="Clear"/>
      </DropDownButton>
      <DropDownButton Content="Оформление">
        <MenuItem Header="Светлая" Command="Light"/><MenuItem Header="Тёмная" Command="Dark"/>
        <MenuItem Header="Контрастная" Command="HighContrastDark"/>
      </DropDownButton>
      <DropDownButton Content="Язык">
        <MenuItem Header="Русский" Command="BatchRussian"/>
        <MenuItem Header="English" Command="BatchEnglish"/>
        <MenuItem Header="العربية" Command="BatchArabic"/>
      </DropDownButton>
    </MenuBar>
    <ToolBar x:Name="Commands" Grid.Row="2" Key="document">
      <Button Content="Подтвердить" Command="Confirm" Icon="Check" Width="150"/>
      <ToggleButton Content="Закрепить" Command="Pin" Icon="Pin" Width="130"/>
      <TextBox x:Name="ToolbarSearch" Text="Поиск в документе" Width="260"/>
      <Button Content="Светлая" Command="Light" Width="110"/>
      <Button Content="Тёмная" Command="Dark" Width="110"/>
      <Button Content="Крупно" Command="Touch" Width="110"/>
    </ToolBar>
    <SplitContainer x:Name="Workspace" Grid.Row="3" Ratio="0.43" FirstMinSize="280" SecondMinSize="360">
      <GroupBox Header="Документ" Appearance="Card">
        <ScrollViewer>
        <StackPanel Spacing="12">
          <TextBlock Text="Сохранённый текст" FontWeight="SemiBold"/>
          <TextBox x:Name="Message" Text="Привет, мир!" IsRequired="True"/>
          <TextBlock Text="Код · фоновая проверка" FontWeight="SemiBold"/>
          <TextBox x:Name="BatchCode" Text="{Binding Code}" AutomationName="Код документа"/>
          <TextBlock x:Name="BatchValidation" Text="Код ещё не подтверждён" TextTone="Secondary" FontSize="12"/>
          <TextBlock x:Name="BatchTotal" Text="{MultiBinding Paths='Quantity;Price', Expression='concat(&quot;Итого: &quot;,$0 * $1)', Mode=OneWay}"/>
          <TextBlock Text="Потяните разделитель: текст и фокус остаются в существующем элементе." TextTone="Secondary"/>
          <TextBlock Text="Длинный заголовок документа с аккуратным сокращением по границе слова" Width="240" TextWrapping="NoWrap" TextTrimming="WordEllipsis" MaxLines="1"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="DetailsButton" Content="Подробности" Width="150" ToolTip="Открыть дополнительную форму" ToolTipHeader="Данные документа" ToolTipIcon="Add"/>
            <LinkButton Content="Подтвердить" Command="Confirm" Width="140"/>
          </StackPanel>
          <Expander Header="Дополнительные сведения" IsExpanded="True" AnimationDurationMs="180">
            <StackPanel Spacing="8">
              <TextBlock Text="Сворачиваемая область сохраняет редактор."/>
              <TextBox x:Name="DetailsDraft" Text="Черновик внутри группы"/>
            </StackPanel>
          </Expander>
          <ProgressBar x:Name="Progress" Value="{Binding Progress}" Height="18"/>
          <BusyIndicator x:Name="Working" Height="18" AutomationName="Обработка документа"/>
          <Popup x:Name="DetailsPopup" PlacementTarget="DetailsButton" PopupWidth="320" PopupHeight="160">
            <StackPanel Spacing="10">
              <TextBlock Text="Содержимое документа" FontWeight="SemiBold"/>
              <TextBox x:Name="PopupDraft" Text="Этот текст сохраняется после закрытия"/>
              <Button Content="Подтвердить" Command="Confirm"/>
            </StackPanel>
          </Popup>
        </StackPanel>
        </ScrollViewer>
      </GroupBox>
      <GroupBox Header="Выбор и диапазоны" Appearance="Card" Margin="12,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <Switch x:Name="Notifications" Content="Уведомления" IsChecked="True"/>
            <CheckBox x:Name="MixedChoice" Content="Частично выбранная группа" IsThreeState="True" IsChecked="{Binding Check}"/>
            <RadioGroup x:Name="LayoutChoice" ItemsSource="{Binding Choices}" SelectedKey="{Binding SelectedKey}" DisplayMemberPath="label" ValueMemberPath="key"/>
            <Separator/>
            <TextBlock Text="Масштаб · клавиши, указатель и отметки" FontWeight="SemiBold"/>
            <Slider x:Name="Scale" Minimum="0" Maximum="100" Value="{Binding Quantity}" Step="5" TickFrequency="10" SnapToTicks="True" AutomationName="Масштаб"/>
            <TextBlock Text="Диапазон · два независимых бегунка" FontWeight="SemiBold"/>
            <RangeSlider x:Name="Interval" Minimum="0" Maximum="100" LowerValue="{Binding Lower}" UpperValue="{Binding Upper}" Step="5" TickFrequency="10" CrossingPolicy="Swap" AutomationName="Диапазон"/>
            <RepeatButton x:Name="RepeatConfirm" Content="Удерживать для повторения" Command="Confirm" RepeatDelayMs="400" RepeatIntervalMs="120"/>
          </StackPanel>
        </ScrollViewer>
      </GroupBox>
    </SplitContainer>
    <TextBlock Grid.Row="4" x:Name="Status" Text="Готово к работе." TextTone="Secondary"/>
  </Grid>
</Window>

