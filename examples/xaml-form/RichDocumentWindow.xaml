<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Документ и форматирование" Width="1240" Height="840" Padding="20">
  <Grid Spacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="5"><TextBlock Text="Документ и форматирование" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Редактирование выбранного абзаца и просмотр страниц. Ctrl+B/I/U — форматирование, Ctrl+Z/Y — отмена и повтор." TextWrapping="Wrap" TextTone="Secondary"/></StackPanel>
    <StackPanel x:Name="RichFileActions" Grid.Row="1" Orientation="Horizontal" Spacing="8"/>
    <Grid x:Name="RichDocumentHost" Grid.Row="2"/>
    <TextBlock x:Name="RichDocumentResult" Grid.Row="3" Text="Открытие и сохранение DOCX выполняются только по команде. Несовместимые возможности показываются явно." TextWrapping="Wrap"/>
  </Grid>
</Window>
