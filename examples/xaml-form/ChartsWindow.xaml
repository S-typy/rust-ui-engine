<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Диаграммы" Width="1100" Height="900" Padding="20">
<Grid Spacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="96"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Spacing="4"><TextBlock Text="Диаграммы и компактный график" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Выберите точку мышью или стрелками. Escape снимает выбор. Пропуск в данных разрывает линию." TextWrapping="Wrap"/></StackPanel>
<Grid x:Name="ChartActions" Grid.Row="1" Height="76" Spacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions></Grid>
<Grid x:Name="ChartHost" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions></Grid>
<Grid x:Name="SparkHost" Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions></Grid>
<TextBlock x:Name="ChartResult" Grid.Row="4" Text="Данные доступны только для чтения; выбор точки не меняет источник." TextWrapping="Wrap"/>
</Grid></Window>
