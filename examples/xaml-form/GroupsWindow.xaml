<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fluent Forms — галерея групп" Width="1200" Height="880" Padding="24">
  <Grid Spacing="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Spacing="6">
      <TextBlock Text="Группы для любых форм" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Карточки, классические рамки, лёгкие заголовки и вкладки. Содержимое сохраняется при переключении." TextTone="Secondary" FontSize="13"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Grid Spacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="16" DataContext="{Binding Form}">
          <TextBlock Text="ПОВЕРХНОСТИ" FontSize="12" FontWeight="SemiBold" TextTone="Secondary"/>
          <GroupBox x:Name="PrimaryGroup" Header="{Binding GroupHeader}" HeaderIcon="Edit" Appearance="Card">
            <StackPanel Spacing="10">
              <TextBlock Text="Карточка · обычный заголовок" FontSize="12" TextTone="Secondary"/>
              <TextBlock Text="Название документа" FontSize="13"/>
              <TextBox x:Name="GroupTitleEditor" Text="{Binding Title}" IsRequired="True" MaxLength="80"/>
              <TextBlock Text="Изменяемый заголовок группы" FontSize="13"/>
              <TextBox x:Name="GroupHeaderEditor" Text="{Binding GroupHeader}" MaxLength="64"/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="OutlineGroup" Header="Параметры документа" HeaderStyle="Light" Appearance="Outline" CornerRadius="4">
            <StackPanel Spacing="10">
              <TextBlock Text="Контур · облегчённый заголовок" FontSize="12" TextTone="Secondary"/>
              <TextBlock Text="Количество" FontSize="13"/>
              <SpinBox Value="{Binding Quantity}" Minimum="1" Maximum="1000"/>
              <TextBlock Text="Дата" FontSize="13"/>
              <DateEdit Value="{Binding Date}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="HeaderlessGroup" Header="Параметры уведомлений" ShowHeader="False" CornerRadius="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Контейнер без заголовка" FontWeight="SemiBold"/>
              <CheckBox Content="Сообщать об изменениях" IsChecked="True"/>
              <TextBlock Text="Та же группа, без строки заголовка." FontSize="12" TextTone="Secondary"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="16">
          <TextBlock Text="ЗАГОЛОВКИ И РАМКИ" FontSize="12" FontWeight="SemiBold" TextTone="Secondary"/>
          <GroupBox x:Name="StandardGroup" Header="Учётная запись" HeaderIcon="Lock" Appearance="Standard" HeaderStyle="Light">
            <StackPanel Spacing="10">
              <TextBlock Text="Классическая подпись на рамке" FontSize="12" TextTone="Secondary"/>
              <TextBlock Text="Имя пользователя" FontSize="13"/>
              <TextBox Text="Анна Смирнова"/>
              <CheckBox Content="Сохранять настройки" IsChecked="True"/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="AccentGroup" Header="Рабочий проект" HeaderIcon="FolderOpen" HeaderStyle="Accent">
            <StackPanel Spacing="10">
              <TextBlock Text="Акцентная шапка следует теме" FontSize="12" TextTone="Secondary"/>
              <TextBox Text="Новая рабочая область"/>
              <GroupBox x:Name="PlainGroup" Header="Уведомления" Appearance="Plain" HeaderStyle="Light" Padding="0,4,0,0">
                <CheckBox Content="Показывать подсказки" IsChecked="True"/>
              </GroupBox>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="CustomHeaderGroup" Header="Индивидуальное оформление" HeaderIcon="Pin" HeaderBackground="#E7EFFA" HeaderForeground="#21496D" CornerRadius="0">
            <StackPanel Spacing="8">
              <TextBlock Text="Собственный цвет заголовка" FontSize="13"/>
              <TextBlock Text="Содержимое сохраняет цвета темы." FontSize="12" TextTone="Secondary"/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="ReadOnlyGroup" Header="Без внешней рамки" Appearance="Plain" HeaderStyle="Light" Padding="0,4,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Header, ElementName=PrimaryGroup}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Form.Title}" FontSize="13" TextTone="Secondary"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="16">
          <TextBlock Text="ВКЛАДКИ И СВОРАЧИВАНИЕ" FontSize="12" FontWeight="SemiBold" TextTone="Secondary"/>
          <TabbedGroup x:Name="DocumentTabs" SelectedIndex="{Binding Form.GroupTab}" Height="222" AutomationName="Разделы документа">
            <GroupTab Header="Данные" HeaderIcon="Edit">
              <StackPanel Spacing="10">
                <TextBlock Text="Одна группа · несколько страниц" FontSize="12" TextTone="Secondary"/>
                <TextBlock Text="Номер документа" FontSize="13"/>
                <TextBox x:Name="TabReferenceEditor" Text="{Binding Form.Reference}"/>
                <TextBlock Text="Вкладки сохраняют введённые значения." FontSize="12" TextTone="Secondary"/>
              </StackPanel>
            </GroupTab>
            <GroupTab Header="История" HeaderIcon="Copy">
              <StackPanel Spacing="10">
                <TextBlock Text="Комментарий к версии" FontSize="13"/>
                <TextBox x:Name="TabHistoryEditor" Text="Первое сохранение"/>
                <TextBlock Text="Выделение и отмена сохраняются." FontSize="12" TextTone="Secondary"/>
              </StackPanel>
            </GroupTab>
            <GroupTab Header="Доступ" HeaderIcon="Lock" IsEnabled="False"/>
          </TabbedGroup>
          <Expander x:Name="DetailsGroup" Header="Дополнительные сведения" HeaderStyle="Light" HeaderIcon="Add" IsExpanded="{Binding Form.DetailsExpanded}">
            <StackPanel Spacing="10" DataContext="{Binding Form}">
              <TextBlock Text="Заметка" FontSize="13"/>
              <TextBox x:Name="GroupNoteEditor" Text="{Binding Note}" PlaceholderText="Текст останется после сворачивания"/>
              <TextBlock Text="Время" FontSize="13"/>
              <TimeEdit x:Name="GroupTimeEditor" Value="{Binding Time}"/>
            </StackPanel>
          </Expander>
          <CheckBox x:Name="DetailsToggle" Content="Показать дополнительные сведения" IsChecked="{Binding Form.DetailsExpanded}"/>
          <GroupBox x:Name="AdvancedGroup" Header="Архив и история" HeaderIcon="Save" IsCollapsible="True" IsExpanded="False" Appearance="Outline">
            <StackPanel Spacing="10">
              <TextBlock Text="GroupBox тоже может сворачиваться." FontSize="13" TextTone="Secondary"/>
              <TextBox x:Name="ArchiveEditor" Text="Новая версия документа"/>
            </StackPanel>
          </GroupBox>
          <TextBlock Text="Стрелки — выбор вкладки. Enter / Space — раскрытие секции." FontSize="12" TextTone="Secondary"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <DockPanel Grid.Row="2">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Светлая" Icon="Sun" Command="Light"/>
        <Button Content="Тёмная" Icon="Moon" Command="Dark"/>
        <Button Content="Обновить данные" Command="ReloadForm"/>
      </StackPanel>
      <TextBlock Text="GroupBox · Expander · TabbedGroup" FontSize="13" TextTone="Secondary" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
