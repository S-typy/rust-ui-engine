<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fluent Forms — строки состояния" Width="1060" Height="760" Padding="0">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="28,24,28,20" Spacing="8">
      <TextBlock Text="Строки состояния" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Одна основа для обычных форм и документов с лентой." FontSize="14" TextTone="Secondary"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="28,0,28,24" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20" DataContext="{Binding Dashboard}">
        <GroupBox Header="Данные и привязки" HeaderIcon="Edit">
          <StackPanel Spacing="10">
            <TextBlock Text="Сообщение в нижней строке" FontSize="12" TextTone="Secondary"/>
            <TextBox x:Name="StatusMessageEditor" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AutomationName="Сообщение состояния"/>
            <Grid Spacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="6">
                <TextBlock Text="Выполнение, %" FontSize="12" TextTone="Secondary"/>
                <SpinBox x:Name="ProgressEditor" Minimum="0" Maximum="100" Value="{Binding Progress}" AutomationName="Выполнение"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Масштаб, %" FontSize="12" TextTone="Secondary"/>
                <SpinBox x:Name="ZoomEditor" Minimum="25" Maximum="400" Increment="10" Value="{Binding Zoom}" AutomationName="Масштаб числом"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="RibbonStatusBar" HeaderIcon="FolderOpen" Padding="0">
          <StackPanel Spacing="0">
            <TextBlock Margin="16,14,16,14" Text="Команды, индикатор выполнения и регулятор масштаба." FontSize="13" TextTone="Secondary"/>
            <RibbonStatusBar x:Name="RibbonStatus" AutomationName="Состояние документа">
              <StatusBarItem><TextBlock Text="Документ · 3 страницы" FontSize="12"/></StatusBarItem>
              <StatusBarItem Placement="Right"><ToggleButton x:Name="RibbonStatusPin" Content="Закрепить" Command="Pin" Icon="Pin" Height="26" Background="#00000000" BorderThickness="0" FontSize="12" Padding="6,2"/></StatusBarItem>
              <StatusBarItem Placement="Right" Width="112"><ProgressBar x:Name="WorkProgress" Value="{Binding Progress}" AutomationName="Выполнение операции"/></StatusBarItem>
              <StatusBarItem Placement="Right" Width="1"><Separator Orientation="Vertical" Height="20"/></StatusBarItem>
              <StatusBarItem Placement="Right" Width="224"><ZoomControl x:Name="Zoom" Value="{Binding Zoom}" AutomationName="Масштаб документа"/></StatusBarItem>
            </RibbonStatusBar>
          </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Светлая тема" Command="Light" Icon="Sun" Width="160"/>
          <Button Content="Тёмная тема" Command="Dark" Icon="Moon" Width="160"/>
        </StackPanel>
        <TextBlock Text="Tab — переход к командам и масштабу · стрелки — шаг · Home / End — границы диапазона" FontSize="12" TextTone="Secondary"/>
      </StackPanel>
    </ScrollViewer>
    <StatusBar x:Name="MainStatus" Grid.Row="2" AutomationName="Состояние формы" DataContext="{Binding Dashboard}">
      <StatusBarItem Width="20"><Icon Symbol="Check" Width="16" Height="16"/></StatusBarItem>
      <StatusBarItem><TextBlock x:Name="Status" Text="{Binding Message}" FontSize="12"/></StatusBarItem>
      <StatusBarItem Placement="Right"><TextBlock Text="Готово" FontSize="12" TextTone="Secondary"/></StatusBarItem>
      <StatusBarItem Placement="Right" Width="1"><Separator Orientation="Vertical" Height="18"/></StatusBarItem>
      <StatusBarItem Placement="Right"><ToggleButton x:Name="StatusPin" Content="Закрепить" Command="Pin" Icon="Pin" Height="24" Background="#00000000" BorderThickness="0" FontSize="12" Padding="6,2"/></StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
