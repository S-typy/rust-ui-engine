<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Расписание и задачи" Width="1180" Height="920" Padding="16">
  <Grid Spacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock x:Name="PlanningTitle" Text="Расписание ресурсов" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="PlanningHint" Text="Выберите встречу. Редактирование и изменение длительности подтверждаются кнопкой «Применить»." TextWrapping="Wrap"/>
    </StackPanel>
    <Grid x:Name="PlanningHost" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
    </Grid>
  </Grid>
</Window>
