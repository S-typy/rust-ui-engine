<Window xmlns="urn:rust-ui-engine:ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Форма данных" Width="1180" Height="800" Padding="24">
  <Grid Spacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="6"><TextBlock Text="Форма данных" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Типизированная запись, явное сохранение и защита от конфликтов." TextTone="Secondary"/></StackPanel>
    <WrapPanel Grid.Row="1" Spacing="8">
      <Button x:Name="FormSave" Content="Сохранить" Command="DataFormSave"/>
      <Button x:Name="FormRefresh" Content="Обновить" Command="DataFormRefresh"/>
      <Button x:Name="FormRevert" Content="Отменить изменения" Command="DataFormRevert"/>
      <Button x:Name="FormArrange" Content="Порядок полей" Command="DataFormArrange"/>
      <Button x:Name="FormToggleNote" Content="Показать / скрыть примечание" Command="DataFormToggleNote"/>
    </WrapPanel>
    <Grid Grid.Row="2" Spacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid Surface="Card" Padding="20"><ScrollViewer><DataForm x:Name="RecordForm" DataSource="FormRecords" RowKey="7" LabelWidth="150" RowGap="12"/></ScrollViewer></Grid>
      <Grid Surface="Card" Grid.Column="1" Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="Сохранённая запись" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="StoredRecord" Text="" TextWrapping="Wrap"/>
          <Separator/>
          <TextBlock Text="Изменение из другого источника" FontWeight="SemiBold"/>
          <TextBlock Text="Измените имя слева, затем нажмите эту кнопку и попробуйте сохранить. Черновик останется при конфликте." TextWrapping="Wrap" TextTone="Secondary"/>
          <Button x:Name="FormExternal" Content="Изменить имя в источнике" Command="DataFormExternal"/>
          <TextBlock x:Name="FormDirty" Text="" TextTone="Secondary"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Spacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FormStatus" Text="Готово" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Светлая" Command="Light"/><Button Content="Тёмная" Command="Dark"/></StackPanel>
    </Grid>
  </Grid>
</Window>
